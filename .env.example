# === App ===
NODE_ENV=development
PORT=3000

# === Database ===
# Docker Compose: usa .env.docker (MSSQL_SERVER=mssql)
# Dev locale: copia .env.local.example → .env.local (MSSQL_SERVER=127.0.0.1)
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=solartracking
MSSQL_PASSWORD=solartracking_pwd
MSSQL_DATABASE=solar_tracking
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# === Solarman API (Phase 1) ===
SOLARMAN_API_URL=https://globalapi.solarmanpv.com
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=
SOLARMAN_STATION_ID=

# === Backup (Cubbit DS3 via rclone) ===
CUBBIT_ACCESS_KEY_ID=
CUBBIT_SECRET_ACCESS_KEY=
CUBBIT_ENDPOINT=s3.cubbit.eu
CUBBIT_REGION=eu-west-1
CUBBIT_BUCKET=solar-tracking-app
CUBBIT_BACKUP_PREFIX=backups
CUBBIT_ARCHIVE_PREFIX=archive
BACKUP_SCHEDULE_TZ=Europe/Rome
BACKUP_SCHEDULE_HOUR=3
BACKUP_RETENTION_DAYS_LOCAL=7
BACKUP_RETENTION_DAYS_REMOTE=30
# RCLONE_REMOTE=cubbit:solar-tracking-app/backups

# === Telegram (Phase 3) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === LLM (Phase 3) ===
LLM_ENDPOINT=http://llm:8080
LLM_MODEL=openllama-3b
